# PostgreSQL and FindBack backend configuration. See backend/README.md.
# Copy to .env locally. Replace placeholders; never commit real credentials.
APP_ENV=development
APP_NAME=FindBack
DATABASE_URL=postgresql+psycopg://findback:CHANGE_ME@localhost:5432/findback
POSTGRES_DB=findback
POSTGRES_USER=findback
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_PORT=5432
JWT_SECRET_KEY=CHANGE_ME_WITH_A_RANDOM_SECRET
JWT_ALGORITHM=HS256
JWT_ISSUER=findback
JWT_AUDIENCE=findback-api
DATABASE_SCHEMA=findback_api
CORS_ORIGINS=http://localhost:5173
# Optional absolute path for managed media. Defaults to backend/uploads.
# MEDIA_ROOT=C:/findback/uploads
# Only public configuration may be exposed to frontend builds.
VITE_API_BASE_URL=http://localhost:8000

# Backend only. Set the key in .env or backend/.env.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_VISION_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_SECONDS=30
AI_MATCHING_ENABLED=true
AI_IMAGE_SEARCH_ENABLED=true
AI_AUTO_POST_ENABLED=true
AI_CHATBOT_ENABLED=true
AI_CPU_THREADS=2
AI_TEXT_INDEX_BATCH=32
AI_IMAGE_INDEX_BATCH=12
AI_REQUESTS_PER_MINUTE=12
AI_GLOBAL_REQUESTS_PER_MINUTE=40
