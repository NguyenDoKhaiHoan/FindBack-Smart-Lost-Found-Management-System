# FindBack Environment Configuration Example
# Copy to .env locally: cp .env.example .env (Never commit real .env to git)

# App Configuration
APP_NAME=FindBack
APP_ENV=development
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]

# Database Configuration (PostgreSQL with asyncpg for FastAPI)
DATABASE_URL=postgresql+asyncpg://findback:findback_secret@localhost:5432/findback
TEST_DATABASE_URL=postgresql+asyncpg://findback:findback_secret@localhost:5432/findback_test

# PostgreSQL Docker Configuration
POSTGRES_USER=findback
POSTGRES_PASSWORD=findback_secret
POSTGRES_DB=findback
POSTGRES_PORT=5432

# Authentication & Security
JWT_SECRET_KEY=CHANGE_ME_WITH_A_SECURE_RANDOM_SECRET_KEY
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# File Storage Directories
PUBLIC_UPLOAD_DIR=./storage/public/posts
PRIVATE_EVIDENCE_DIR=./storage/private/claim_evidence

# Frontend API URL
VITE_API_BASE_URL=http://localhost:8000
