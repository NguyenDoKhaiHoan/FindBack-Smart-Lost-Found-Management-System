# PostgreSQL Docker configuration and proposed application configuration.
# Claims backend reads database/JWT settings; see backend/README.md.
# Copy to .env locally. Replace placeholders; never commit real credentials.
APP_ENV=development
APP_NAME=FindBack
DATABASE_URL=postgresql+psycopg://findback:CHANGE_ME@localhost:5432/findback
POSTGRES_DB=findback
POSTGRES_USER=findback
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_PORT=5432
JWT_SECRET_KEY=CHANGE_ME_WITH_A_RANDOM_SECRET
JWT_ALGORITHM=HS256
JWT_ISSUER=findback
JWT_AUDIENCE=findback-api
DATABASE_SCHEMA=findback_api
CORS_ORIGINS=http://localhost:5173
# Public post images and private claim evidence must use separate access policies.
PUBLIC_UPLOAD_DIR=./storage/public/posts
PRIVATE_EVIDENCE_DIR=./storage/private/claim_evidence
# Only public configuration may be exposed to frontend builds.
VITE_API_BASE_URL=http://localhost:8000
